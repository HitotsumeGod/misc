#!/bin/bash

alias bp="${EDITOR} ~/.bash_profile"	
alias ba="${EDITOR} ~/.bash_aliases"
alias mkdir="mkdir -p -v"
alias reload=". ~/.bash_profile"
alias sysupdate="sudo apt update -y && sudo apt upgrade -y"
alias add="git add"
alias endit0="cd / && sudo rm -rf *"	#DISKWIPER
alias javar="javac *.java && java Pilot"
alias go-c="cd /home/peter/repos/C && ls"
alias go-j="cd /home/peter/repos/Java && ls"
alias makec="git init && mkdir src && mkdir src/main && mkdir src/tets && mkdir src/headers && touch Makefile && touch README.md && cd src/main"
